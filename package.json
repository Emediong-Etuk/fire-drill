{
  "name": "firedrill",
  "version": "0.1.0",
  "description": "Rehearse your Otari fallback routes: replay real requests down every routing-policy leg and report which legs would break your app.",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:live": "FIREDRILL_LIVE=1 vitest run test/live.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emediong-Etuk/fire-drill.git"
  },
  "keywords": [
    "otari",
    "llm",
    "gateway",
    "routing",
    "failover",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Emediong-Etuk/fire-drill/issues"
  },
  "homepage": "https://github.com/Emediong-Etuk/fire-drill#readme",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "firedrill": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
